# Korean LLM FinTech audit — environment variables
# Copy to `.env` and fill in values:  cp .env.example .env
# Never commit `.env` (real keys).

# -----------------------------------------------------------------------------
# OpenAI (required for real runs — scripts 02 generate & 03 judge)
# Get a key: https://platform.openai.com/api-keys
# -----------------------------------------------------------------------------
OPENAI_API_KEY=

# Optional: OpenAI-compatible API (Anthropic proxy, Azure OpenAI-style gateways, etc.)
# Leave unset to use the default OpenAI API host.
# OPENAI_BASE_URL=

# Optional: OpenAI organization id if your account uses one
# OPENAI_ORG_ID=

# -----------------------------------------------------------------------------
# Anthropic (optional — multi-model generation: anthropic/... in scripts/02)
# https://console.anthropic.com/settings/keys
# -----------------------------------------------------------------------------
# ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Google Gemini (optional — multi-model generation: google/... in scripts/02)
# https://aistudio.google.com/apikey
# -----------------------------------------------------------------------------
# GOOGLE_API_KEY=
# If your tooling only documents GEMINI_API_KEY, either name works in .env:
# GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# NAVER CLOVA Studio / HyperCLOVA X (optional — scripts/02 with clova/...)
# OpenAI-compatible API. Issue key in NAVER Cloud Platform → CLOVA Studio.
# Docs: https://api.ncloud-docs.com/docs/en/clovastudio-openaicompatibility
# -----------------------------------------------------------------------------
# CLOVA_STUDIO_API_KEY=
# Optional override if NAVER changes the host (default is stream endpoint):
# CLOVA_STUDIO_OPENAI_BASE_URL=https://clovastudio.stream.ntruss.com/v1/openai
# Alias some accounts use:
# NAVER_CLOVA_STUDIO_API_KEY=

# -----------------------------------------------------------------------------
# OpenRouter (optional — scripts/02 with openrouter/...; one key, many catalog models)
# https://openrouter.ai/keys
# Model id after openrouter/ must match OpenRouter (e.g. openai/gpt-4o → spec openrouter/openai/gpt-4o)
# -----------------------------------------------------------------------------
# OPENROUTER_API_KEY=
# OPENROUTER_HTTP_REFERER=https://yoursite.local
# OPENROUTER_APP_NAME=Fintech LLM Audit

# -----------------------------------------------------------------------------
# Default advice models (optional — scripts/02 if you omit --models and --model)
# Comma-separated; same entries as config/advice_models.txt. CLI --models wins.
# -----------------------------------------------------------------------------
# AUDIT_ADVICE_MODELS=openrouter/openai/gpt-4o-mini,openrouter/openai/gpt-4o

# -----------------------------------------------------------------------------
# Hugging Face (optional — scripts/00_sample_personas.py)
# Improves rate limits when downloading nvidia/Nemotron-Personas-Korea
# https://huggingface.co/settings/tokens
# -----------------------------------------------------------------------------
# HF_TOKEN=
